  "motion": {
    "transition": {
      "$type": "transition",
      "color": {
        "$value": {
          "duration": "{duration.base}",
          "delay": "0ms",
          "timingFunction": "{easing.standard}"
        },
        "$description": "Hover / state colour changes."
      },
      "control": {
        "$value": {
          "duration": "{duration.slow}",
          "delay": "0ms",
          "timingFunction": "{easing.standard}"
        },
        "$description": "Toggles, tab indicator."
      },
      "enter": {
        "$value": {
          "duration": "{duration.slower}",
          "delay": "0ms",
          "timingFunction": "{easing.out-expo}"
        },
        "$description": "`pance-rise` entrance."
      }
    }
  },
