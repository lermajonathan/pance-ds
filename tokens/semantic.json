    },
    "full": {
      "$value": "{radius.pill}",
      "$description": "Pills, avatars, toggles."
    }
  },
  "shadow": {
    "$type": "shadow",
    "none": {
      "$value": [],
      "$description": "Level 0 · Flat."
    },
    "xs": {
      "$value": [
        {
          "color": "rgba(15,23,42,0.06)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
