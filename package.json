{
  "name": "pance-design-system",
  "private": true,
  "version": "1.0.0",
  "description": "Pance Design System \u2014 river-inspired tokens, React components and documentation site. Bilingual (EN/ES).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:keyboard": "node tests/keyboard.mjs",
    "test:axe": "node tests/axe.mjs",
    "lint:tokens": "node scripts/check-token-usage.mjs",
    "test:contrast": "node tests/contrast.mjs --strict",
    "build:packages": "node scripts/build-tokens.mjs && node scripts/build-packages.mjs",
    "test:packages": "node tests/packages.mjs",
    "docs": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "test:docs": "node tests/docs-examples.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:visual:capture": "node tests/visual.mjs --update"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "4.10.3",
    "oxfmt": "^0.2.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.3"
}
